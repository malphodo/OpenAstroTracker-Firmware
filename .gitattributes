# Store text files with LF line endings, like the official repository.
# Mixed CRLF/LF files caused spurious conflicts when merging upstream.
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.bmp binary
*.bin binary
